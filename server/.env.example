# DEVWORLD platform server — local development defaults.
# Copy to .env and source it, or export only what you need.
# These match infra/docker-compose.yml; override every secret before deploying.

HOST=0.0.0.0
PORT=8091

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=devworld
CLICKHOUSE_PASSWORD=devworld_dev_pw
CLICKHOUSE_DB=devworld

KV_URL=redis://:devworld_dev_pw@127.0.0.1:6666
REDIS_URL=redis://:devworld_dev_pw@127.0.0.1:6379

# Execution worker. Empty disables grading (POST /missions/:id/submit -> 503).
WORKER_URL=
WORKER_API_KEY=

ADMIN_KEY=dev_admin_key

CONTENT_DIR=../game-shell/content
SESSION_TTL_SEC=604800
BALANCE_CACHE_TTL_SEC=15

# ---- OAuth sign-in ----------------------------------------------------------
# Public origin of this API. Every provider redirect URI is
# <OAUTH_BASE_URL>/auth/oauth/<provider>/callback, so this must match what you
# register with each provider. HTTPS requests use the system curl binary.
OAUTH_BASE_URL=http://127.0.0.1:8091
# Front-end origins allowed to receive the session after sign-in (comma list).
OAUTH_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional fallback return URL when a client does not send returnTo.
OAUTH_SUCCESS_REDIRECT=
OAUTH_STATE_TTL_SEC=600
OAUTH_HTTP_TIMEOUT_MS=15000

# Only providers with both a client id and secret are advertised by
# GET /auth/providers. Leave the rest empty.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Any standards-compliant OIDC provider ("and more") can be added without code:
# OAUTH_OIDC_NAME=Acme SSO
# OAUTH_OIDC_CLIENT_ID=
# OAUTH_OIDC_CLIENT_SECRET=
# OAUTH_OIDC_AUTHORIZE_URL=https://sso.example.com/oauth2/authorize
# OAUTH_OIDC_TOKEN_URL=https://sso.example.com/oauth2/token
# OAUTH_OIDC_USERINFO_URL=https://sso.example.com/oauth2/userinfo
# OAUTH_OIDC_SCOPE=openid email profile
