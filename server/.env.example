# DEVWORLD platform server — local development defaults.
# Copy to .env and source it, or export only what you need.
# These match infra/docker-compose.yml; override every secret before deploying.

HOST=0.0.0.0
PORT=8091

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=devworld
CLICKHOUSE_PASSWORD=devworld_dev_pw
CLICKHOUSE_DB=devworld

KV_URL=redis://:devworld_dev_pw@127.0.0.1:6666
REDIS_URL=redis://:devworld_dev_pw@127.0.0.1:6379

# Execution worker. Empty disables grading (POST /missions/:id/submit -> 503).
WORKER_URL=
WORKER_API_KEY=

ADMIN_KEY=dev_admin_key

CONTENT_DIR=../game-shell/content
SESSION_TTL_SEC=604800
BALANCE_CACHE_TTL_SEC=15
