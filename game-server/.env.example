# DEVWORLD game server — local development defaults (copy to .env to override).
# In Docker Compose the store hostnames resolve on the `devworld` network; when
# running `bun server.ts` on the host, use 127.0.0.1.

PORT=8091

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=devworld
CLICKHOUSE_USER=devworld
CLICKHOUSE_PASSWORD=devworld_dev_pw

# Durable key-value (Kvrocks / RocksDB)
KV_URL=redis://:devworld_dev_pw@127.0.0.1:6666
# Cache (Redis)
REDIS_URL=redis://:devworld_dev_pw@127.0.0.1:6379

# Sandbox worker for grading (leave empty to disable submission)
WORKER_URL=http://127.0.0.1:8090
WORKER_API_KEY=

# Internal admin endpoint key
ADMIN_KEY=dev_admin_key

# Session / cache lifetimes
SESSION_TTL_SEC=604800
BALANCE_CACHE_TTL_SEC=15

# Mission content
CONTENT_DIR=../game-shell/content
