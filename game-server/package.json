{
  "name": "devworld-game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DEVWORLD game API — players, sessions, ledger, progression and mission grading on ClickHouse + Redis + RocksDB (Kvrocks).",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "test": "bun test",
    "test:integration": "DEVWORLD_IT=1 bun test tests/integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
