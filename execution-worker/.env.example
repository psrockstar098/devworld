# Copy to .env and fill in. Never commit .env.
# Long random API key the game frontend sends as the x-api-key header.
EXEC_API_KEY=change-me-to-a-long-random-string
PORT=8090
# Host path for submission scratch dirs. Must be bind-mounted 1:1 into the
# worker container (see docker-compose.yml). Create it on the host first.
SUBMISSIONS_DIR=/submissions
# Abuse controls.
EXEC_QUOTA_PER_HOUR=60
EXEC_MAX_CONCURRENT=4
# Max total submission bytes per request (files + tests).
EXEC_MAX_REQUEST_BYTES=1048576

# Optional: durable submission store on the shared RocksDB service (Kvrocks).
# Leave unset to keep submissions in memory (single process, non-durable).
KV_URL=redis://:devworld_dev_pw@127.0.0.1:6666
# Optional: ClickHouse event sink for grading + moderation telemetry.
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=devworld
CLICKHOUSE_USER=devworld
CLICKHOUSE_PASSWORD=devworld_dev_pw
