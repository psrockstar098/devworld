# DEVWORLD data infrastructure — copy to .env and change every value before
# any non-local use. Compose also has these same values as dev defaults, so a
# bare `docker compose up` works without this file.

# --- ClickHouse (main / columnar database) ---
CLICKHOUSE_DB=devworld
CLICKHOUSE_USER=devworld
CLICKHOUSE_PASSWORD=devworld_dev_pw
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Kvrocks (RocksDB-backed key-value store) ---
KV_PORT=6666
KV_PASSWORD=devworld_dev_pw

# --- Redis (cache / realtime) ---
REDIS_PORT=6379
REDIS_PASSWORD=devworld_dev_pw
REDIS_MAXMEMORY=512mb
